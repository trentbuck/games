  <!-- Try to get to 1km/s 250m/s� combat and 15km/s 1km/s� travel -->
  <replace sel="/macros/macro[@name='ship_ter_s_xperimental_01_a_macro']/properties/jerk">
    <jerk>
      <forward accel="1" decel="1" />
      <forward_boost accel="1" />
      <forward_travel accel="3" decel="3" />
      <strafe value="1" />
      <angular value="1" />
    </jerk>
  </replace>
  <replace sel="/macros/macro[@name='ship_ter_s_xperimental_01_a_macro']/properties/physics">
    <physics mass="1">
      <!-- With exactly zero inertia, piloting feels very nice, but
	   autopilot (and even the Enter menu) constantly jiggles back and forth.
	   Also overshoots gates and disables autopilot constantly, very annoying.
	   If I set it to a very small value can I fix the latter?
      -->
      <inertia pitch="0" yaw="0" roll="1" />
      <drag forward="1" reverse="1" horizontal="1" vertical="1" pitch="1" yaw="1" roll="1" />
      <accfactors forward="1.5" reverse="1.5" />
    </physics>
  </replace>

